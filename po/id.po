#: crates/ui/src/pages.rs:668
msgid "The selected key has no presses."
msgstr "Tombol yang dipilih tidak memiliki tekanan."

#: crates/ui/src/pages.rs:672
msgid "Press %lld"
msgstr "Tekanan %lld"

#: crates/ui/src/pages.rs:684
msgid "Each press can wait before it is sent. Give the key its presses on the Keys page first."
msgstr "Setiap tekanan dapat menunggu sebelum dikirim. Tambahkan dulu tekanan tombol di halaman Tombol."

#: crates/ui/src/pages.rs:698
msgid "One wait for the whole key. Its presses stay."
msgstr "Satu jeda untuk seluruh tombol. Tekanannya tetap ada."

