msgid "Shift Symbols"
msgstr "Ký hiệu Shift"

#: crates/ui/src/pages.rs:504 crates/ui/src/pages.rs:540
msgid "Color"
msgstr "Màu"

#: crates/ui/src/pages.rs:508 crates/ui/src/pages.rs:572
msgid "Lighting is set per layer; no key selection is needed."
msgstr "Đèn được đặt riêng cho từng lớp nên không cần chọn phím."

#: crates/ui/src/pages.rs:539
msgid "Select one of keys 1–%lld on the keyboard, then pick its color."
msgstr "Hãy chọn một trong các phím 1–%lld trên bàn phím, rồi chọn màu cho phím."

#: crates/ui/src/pages.rs:585
msgid "Effect"
msgstr "Hiệu ứng"

#: crates/ui/src/pages.rs:668
msgid "The selected key has no presses."
msgstr "Phím đã chọn không có lần nhấn nào."

#: crates/ui/src/pages.rs:672
msgid "Press %lld"
msgstr "Lần nhấn %lld"

#: crates/ui/src/pages.rs:684
msgid "Each press can wait before it is sent. Give the key its presses on the Keys page first."
msgstr "Mỗi lần nhấn có thể chờ trước khi được gửi. Hãy thêm các lần nhấn cho phím ở trang Phím trước."

#: crates/ui/src/pages.rs:698
msgid "One wait for the whole key. Its presses stay."
msgstr "Một lần chờ cho cả phím. Các lần nhấn của phím vẫn được giữ."

