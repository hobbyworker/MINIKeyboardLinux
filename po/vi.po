msgstr "Phím đa phương tiện sẽ thay thế tác vụ trước đó của phím."

#: crates/ui/src/pages.rs:78
msgid "A mouse action replaces what the key did."
msgstr "Tác vụ chuột sẽ thay thế tác vụ trước đó của phím."

#: crates/ui/src/pages.rs:187
msgid "Key Layout"
msgstr "Bố cục phím"

#: crates/ui/src/pages.rs:188
msgid "Modifiers Only"
msgstr "Chỉ phím bổ trợ"

#: crates/ui/src/pages.rs:189
msgid "Makes the key hold these modifiers, as a modifier key does."
msgstr "Phím sẽ giữ các phím bổ trợ này, giống như một phím bổ trợ."

#: crates/ui/src/pages.rs:262
msgid "Modifiers apply to the next key."
msgstr "Phím bổ trợ áp dụng cho phím bấm tiếp theo."

#: crates/ui/src/pages.rs:264
msgid "Modifiers apply to the next key. A key holds up to %lld presses, each modifier counting as one."
msgstr "Phím bổ trợ áp dụng cho phím bấm tiếp theo. Mỗi phím chứa tối đa %lld lần nhấn, tính cả từng phím bổ trợ."

#: crates/ui/src/pages.rs:269
msgid "Modifiers apply to the next key. A key holds up to %lld presses."
msgstr "Phím bổ trợ áp dụng cho phím bấm tiếp theo. Mỗi phím chứa tối đa %lld lần nhấn."

#: crates/ui/src/pages.rs:333
msgid "This keyboard doesn’t take this key."
msgstr "Không thể gán phím này cho bàn phím này."

#: crates/ui/src/pages.rs:354
msgid "More Keys"
msgstr "Phím khác"

#: crates/ui/src/pages.rs:370
msgid "Modifiers"
msgstr "Phím bổ trợ"

